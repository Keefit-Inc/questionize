# Which provider the pipeline calls: "meta" (Meta Model API) or "baseten" (Muse Spark Open)
LLM_PROVIDER=meta

# Meta Model API — https://dev.meta.ai
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Baseten (Muse Spark Open, open-weight) — use the hackathon model ID
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Pipeline tuning
MAX_REVISIONS=2
REQUEST_TIMEOUT_SECONDS=120

# Comma-separated origins allowed to call the API (chrome-extension://<id>), or * while developing
ALLOWED_ORIGINS=*
