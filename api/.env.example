# Rails API. Copy to .env for local overrides; production values come from Kamal secrets.

# Production only: signs cookies and tokens. Generate with: bin/rails secret
SECRET_KEY_BASE=

# Production database password (user "questionize")
QUESTIONIZE_DATABASE_PASSWORD=

# AI service: internal URL and the shared X-Internal-Token value (same as ai/.env INTERNAL_TOKEN)
AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=
# Seconds to wait on the AI service stream (generation can take a few minutes)
AI_SERVICE_READ_TIMEOUT=600

# Facebook Login (developers.facebook.com → your app → App settings → Basic).
# The app id is public; the secret must stay out of the repository.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Levels that also get a practice question from every snapped question's design (comma-separated;
# empty to turn off). Each costs a full writing and verification pass.
PRACTICE_FANOUT_LEVELS=middle,high,college
