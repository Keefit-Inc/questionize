# Shared secret Rails sends in the X-Internal-Token header. Required: with it empty, /v1 refuses every request.
# Generate one with: openssl rand -hex 32
INTERNAL_TOKEN=

# Which provider the pipeline calls: "meta" (Meta Model API, default), "baseten" (Muse Spark Open)
# or "anthropic" (Claude). SOLVER_PROVIDER / SOLVER_MODEL let the blind solver use another model;
# leave them blank to reuse the primary provider.
LLM_PROVIDER=meta
SOLVER_PROVIDER=
SOLVER_MODEL=

# Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=high

# Meta Model API — https://dev.meta.ai
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Baseten (Muse Spark Open, open-weight) — use the hackathon model ID
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026

# Argument Judge: samples per judge model and the gate an item must clear
JUDGE_ENABLED=true
JUDGE_SAMPLES=3
JUDGE_MIN_FIRST_RATE=0.9
JUDGE_MIN_MARGIN=0.15

# Pipeline tuning
MAX_REVISIONS=2
REQUEST_TIMEOUT_SECONDS=300
